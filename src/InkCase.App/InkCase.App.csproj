<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lmm.Plugins.English\Lmm.Plugins.English.csproj" />
    <ProjectReference Include="..\Lmm.Plugins.Abstractions\Lmm.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\Lmm.Import\Lmm.Import.csproj" />
    <ProjectReference Include="..\Lmm.Translation\Lmm.Translation.csproj" />
    <ProjectReference Include="..\Lmm.Format\Lmm.Format.csproj" />
    <ProjectReference Include="..\Lmm.Core\Lmm.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Product name: 墨案 / InkCase. The exe is InkCase.exe; namespaces stay InkCase.App. -->
    <AssemblyName>InkCase</AssemblyName>
    <Product>墨案 InkCase</Product>
    <AssemblyTitle>墨案 InkCase</AssemblyTitle>
    <!-- Allows restore/build to proceed on non-Windows dev machines (e.g. this Linux container).
         Actual WPF compilation/run still requires Windows + VS2026. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Per-monitor DPI awareness; see app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
