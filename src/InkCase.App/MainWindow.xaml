<Window x:Class="InkCase.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:InkCase.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="墨案" Icon="app.ico" Height="920" Width="1440" MinHeight="520" MinWidth="820"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brand}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrandSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Brand}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brand}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="B" Background="Transparent" Padding="14,8" Margin="0,0,4,0" CornerRadius="7">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brand}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ================= header ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- brand row: drag area + window buttons -->
                <Grid Height="54" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="app.ico" Width="32" Height="32" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="墨案" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
                            <TextBlock x:Name="SubtitleText" Text=".lmm 试卷 · 未打开"
                                       FontSize="11.5" Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinBtn" Content="—" Width="44" Height="34" FontSize="13"
                                Background="Transparent" BorderThickness="0" Click="MinBtn_Click"
                                ToolTip="最小化" />
                        <Button x:Name="MaxBtn" Content="□" Width="44" Height="34" FontSize="13"
                                Background="Transparent" BorderThickness="0" Click="MaxBtn_Click"
                                ToolTip="最大化 / 还原" />
                        <Button x:Name="CloseBtn" Content="✕" Width="46" Height="34" FontSize="13"
                                Background="Transparent" BorderThickness="0" Click="CloseBtn_Click"
                                ToolTip="关闭" />
                    </StackPanel>
                </Grid>

                <!-- section tabs -->
                <ListBox x:Name="SectionList" BorderThickness="0" Background="Transparent"
                         Margin="14,0,14,0" Padding="0" MinHeight="46"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="SectionList_SelectionChanged" Focusable="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" Padding="13,8" CornerRadius="8,8,0,0"
                                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface2}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brand}" />
                                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Sub}" FontSize="10.5" Foreground="{DynamicResource Muted}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- toolbar -->
                <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                    <WrapPanel Margin="14,7" Orientation="Horizontal">
                        <Button Content="打开…" Style="{StaticResource ToolButton}" Click="OpenPaper_Click"
                                ToolTip="打开 .lmm 试卷 (Ctrl+O)" />
                        <Button Content="导入…" Style="{StaticResource ToolButton}" Click="Import_Click"
                                ToolTip="从文本 / 图片导入生成试卷 (Ctrl+I)" />
                        <Button Content="保存" Style="{StaticResource ToolButton}" Click="SavePaper_Click"
                                ToolTip="保存 (Ctrl+S)" />
                        <Button Content="另存为…" Style="{StaticResource ToolButton}" Click="SaveAsPaper_Click" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="4,0,10,0" />

                        <ToggleButton x:Name="InkToggle" Content="批注" Style="{StaticResource ToolToggle}"
                                      Checked="InkToggle_Changed" Unchecked="InkToggle_Changed"
                                      ToolTip="打开后在文章上自由手写，笔迹随试卷保存" />
                        <!-- Six pens ported from xnotes; each one shapes the ribbon differently. -->
                        <ToggleButton x:Name="InkStylePen" Content="钢笔" Tag="pen" Style="{StaticResource ToolToggle}"
                                      Click="InkStyle_Click" ToolTip="标准钢笔：压感决定粗细" />
                        <ToggleButton x:Name="InkStyleDashed" Content="虚线" Tag="dashed" Style="{StaticResource ToolToggle}"
                                      Click="InkStyle_Click" ToolTip="等宽虚线，用来划线、圈范围" />
                        <ToggleButton x:Name="InkStyleCalligraphy" Content="书法" Tag="calligraphy" Style="{StaticResource ToolToggle}"
                                      Click="InkStyle_Click" ToolTip="斜切笔尖：横细竖粗" />
                        <ToggleButton x:Name="InkStyleSpeed" Content="速度" Tag="speed" Style="{StaticResource ToolToggle}"
                                      Click="InkStyle_Click" ToolTip="写得快就细、写得慢就粗" />
                        <ToggleButton x:Name="InkStyleTaper" Content="收锋" Tag="taper" Style="{StaticResource ToolToggle}"
                                      Click="InkStyle_Click" ToolTip="起笔饱满、收笔渐细" />
                        <ToggleButton x:Name="InkStyleHighlighter" Content="荧光" Tag="highlighter" Style="{StaticResource ToolToggle}"
                                      Click="InkStyle_Click" ToolTip="半透明荧光笔，适合大字横扫" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="4,0,10,0" />
                        <!-- 粗细：作用于当前这支笔，每支笔各记各的宽度。 -->
                        <Button x:Name="WidthDown" Content="细" Style="{StaticResource ToolButton}"
                                Click="WidthDown_Click" ToolTip="当前这支笔细一档（Ctrl+[）" />
                        <TextBlock x:Name="WidthText" Text="5.0" Foreground="{DynamicResource Muted}" FontSize="12"
                                   VerticalAlignment="Center" MinWidth="30" TextAlignment="Center"
                                   ToolTip="当前这支笔的基准粗细（DIP）；同一支笔换回来还是这个宽度" />
                        <Button x:Name="WidthUp" Content="粗" Style="{StaticResource ToolButton}"
                                Click="WidthUp_Click" ToolTip="当前这支笔粗一档（Ctrl+]）" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="4,0,10,0" />
                        <Button Content="撤销一笔" Style="{StaticResource ToolButton}" Click="UndoInk_Click" />
                        <Button Content="清除本节" Style="{StaticResource ToolButton}" Click="ClearInk_Click" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="4,0,10,0" />

                        <Button x:Name="ThemeBtn" Content="外观：自动" Style="{StaticResource ToolButton}"
                                Click="Theme_Click" ToolTip="跟随 Windows 深浅色；点一下在 自动 → 浅色 → 深色 之间循环" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="4,0,10,0" />
                        <ToggleButton x:Name="RevealToggle" Content="显示全部答案" Style="{StaticResource ToolToggle}"
                                      Checked="RevealToggle_Changed" Unchecked="RevealToggle_Changed"
                                      ToolTip="一键显示 / 隐藏所有题目的答案与解析" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Line}" Margin="4,0,10,0" />

                        <Button Content="A−" Style="{StaticResource ToolButton}" Click="ZoomOut_Click" ToolTip="缩小字号" />
                        <TextBlock x:Name="ZoomText" Text="100%" Foreground="{DynamicResource Muted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Content="A＋" Style="{StaticResource ToolButton}" Click="ZoomIn_Click" ToolTip="放大字号" />

                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="{DynamicResource Muted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" FontSize="11" Opacity="0.8"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   ToolTip="版本号 = 大版本.小版本.本小版本提交数.总提交数" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ================= content ================= -->
        <Grid x:Name="RootGrid" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="400" MinWidth="300" MaxWidth="760" />
            </Grid.ColumnDefinitions>

            <!-- left card: article -->
            <Border x:Name="LeftCard" Style="{StaticResource Card}" Grid.Column="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="24,16,24,10">
                        <StackPanel>
                            <TextBlock x:Name="ArticleTitle" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ArticleMeta" FontSize="12" Foreground="{DynamicResource Muted}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="ArticleScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"
                                  PreviewMouseDown="ArticleScroll_PreviewMouseDown">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemeScrollBar}" />
                        </ScrollViewer.Resources>
                        <Grid>
                            <StackPanel x:Name="ArticlePanel" Margin="28,6,34,120" />
                            <controls:InkCanvasElement x:Name="InkCanvas"
                                                       Height="{Binding ActualHeight, ElementName=ArticlePanel}"
                                                       HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                       Visibility="Collapsed"
                                                       StrokeFinished="InkCanvas_StrokeFinished" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- right card: panels -->
            <Border x:Name="RightCard" Style="{StaticResource Card}" Grid.Column="2">
                <TabControl x:Name="RightTabs" BorderThickness="0" Background="Transparent" Padding="0"
                            SelectionChanged="RightTabs_SelectionChanged"
                            ItemContainerStyle="{StaticResource SegTab}">
                    <TabItem Header="题目">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="QuestionList" Grid.Row="0" BorderThickness="0" Background="Transparent"
                                     HorizontalContentAlignment="Stretch" Padding="8,4"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="QuestionList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="B" Background="Transparent" CornerRadius="9" Margin="0,0,0,6"
                                                            Padding="12,9" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="{DynamicResource Surface2}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrandSoft}" />
                                                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brand}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Ink}" />
                                            <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource Muted}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                                    Background="{DynamicResource Surface2}" MaxHeight="330">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemeScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <Grid>
                                        <StackPanel x:Name="DetailPanel" Margin="16,12,16,20" />
                                        <!-- 答案区也能手写：同一套笔，锚在「哪个题」的详情上。 -->
                                        <controls:InkCanvasElement x:Name="AnswerInkCanvas"
                                                                   Height="{Binding ActualHeight, ElementName=DetailPanel}"
                                                                   HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                                   Surface="answer"
                                                                   Visibility="Collapsed"
                                                                   StrokeFinished="AnswerInkCanvas_StrokeFinished" />
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="段落结构">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemeScrollBar}" />
                            </ScrollViewer.Resources>
                            <Grid>
                                <StackPanel x:Name="StructurePanel" Margin="16,10,16,20" />
                                <controls:InkCanvasElement x:Name="StructureInkCanvas"
                                                           Height="{Binding ActualHeight, ElementName=StructurePanel}"
                                                           HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                           Surface="structure"
                                                           Visibility="Collapsed"
                                                           StrokeFinished="StructureInkCanvas_StrokeFinished" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="中英对照">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Margin="16,8,16,2">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TranslateBtn" Content="机翻本节" Style="{StaticResource ToolButton}"
                                            Click="Translate_Click" ToolTip="调用在线翻译（MyMemory）补齐中英对照" />
                                    <TextBlock x:Name="TranslateHint" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemeScrollBar}" />
                                </ScrollViewer.Resources>
                                <Grid>
                                    <StackPanel x:Name="BilingualPanel" Margin="16,8,16,20" />
                                    <controls:InkCanvasElement x:Name="BilingualInkCanvas"
                                                               Height="{Binding ActualHeight, ElementName=BilingualPanel}"
                                                               HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                               Surface="bilingual"
                                                               Visibility="Collapsed"
                                                               StrokeFinished="BilingualInkCanvas_StrokeFinished" />
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="课堂小练">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemeScrollBar}" />
                            </ScrollViewer.Resources>
                            <Grid>
                                <StackPanel x:Name="DrillPanel" Margin="16,10,16,20" />
                                <controls:InkCanvasElement x:Name="DrillInkCanvas"
                                                           Height="{Binding ActualHeight, ElementName=DrillPanel}"
                                                           HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                                           Surface="drills"
                                                           Visibility="Collapsed"
                                                           StrokeFinished="DrillInkCanvas_StrokeFinished" />
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- empty state -->
            <Border x:Name="EmptyState" Grid.ColumnSpan="3" Background="{DynamicResource EmptyBg}" CornerRadius="14"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <Image Source="app.ico" Width="64" Height="64" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock Text="还没有打开试卷" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                               HorizontalAlignment="Center" Margin="0,18,0,6" />
                    <TextBlock Text="把 .lmm 文件拖到窗口里，或点下面的按钮。壳本身不带任何试卷内容。"
                               FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" LineHeight="22" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Content="打开 .lmm…" Style="{StaticResource ToolButton}" Padding="18,9" FontSize="13.5"
                                Click="OpenPaper_Click" />
                        <Button Content="从文本导入…" Style="{StaticResource ToolButton}" Padding="18,9" FontSize="13.5"
                                Margin="10,0,0,0" Click="Import_Click" />
                    </StackPanel>
                    <TextBlock Text="Ctrl+O 打开 · Ctrl+S 保存 · Ctrl+I 导入" FontSize="11.5"
                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
