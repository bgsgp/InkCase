<Window x:Class="ExamReview.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExamReview.App.Controls"
        mc:Ignorable="d"
        Title="ExamReview" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Content="打开…" Click="OpenPaper_Click" ToolTip="打开一个 .lmm 试卷文件 (Ctrl+O)" />
                <Button Content="保存" Click="SavePaper_Click" ToolTip="保存到当前文件 (Ctrl+S)" />
                <Button Content="另存为…" Click="SaveAsPaper_Click" />
                <Separator />
                <Button Content="新建示例卷" Click="NewSample_Click" />
                <Separator />
                <ToggleButton x:Name="InkToggle" Content="批注" Checked="InkToggle_Changed" Unchecked="InkToggle_Changed"
                              ToolTip="打开后可以在文章上自由手写批注，笔迹按章节保存进 .lmm" />
                <Button Content="清除本节笔迹" Click="ClearInk_Click" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
                <ListBox x:Name="SectionList" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SectionList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <DockPanel Grid.Column="1" Margin="10,0">
                <TextBlock x:Name="ArticleHeader" DockPanel.Dock="Top" FontSize="13" Foreground="#555" Margin="6,0,6,8" TextWrapping="Wrap" />
                <ScrollViewer x:Name="ArticleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="ArticlePanel" Margin="30,20,30,90" />
                        <controls:InkCanvasElement x:Name="InkCanvas"
                                                   Height="{Binding ActualHeight, ElementName=ArticlePanel}"
                                                   VerticalAlignment="Top"
                                                   Visibility="Collapsed"
                                                   StrokeFinished="InkCanvas_StrokeFinished" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <TabControl Grid.Column="2">
                <TabItem Header="题目">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="300" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="QuestionList" Grid.Row="0"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 SelectionChanged="QuestionList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Preview}" Foreground="#555" FontSize="12"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderBrush="#DDD" BorderThickness="0,1,0,0">
                            <StackPanel x:Name="DetailPanel" Margin="10,8,10,20" />
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="段落结构">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StructurePanel" Margin="10" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="中英对照">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BilingualPanel" Margin="10" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="课堂小练">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DrillPanel" Margin="10" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
