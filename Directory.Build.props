<Project>

  <!--
    版本号方案（用户约定）：大版本.小版本.本小版本提交数.总提交数
    起点是旧版 Claude 生成的 2.3.1.13（用户指定的「从我命的版本号开始堆」），
    所以大版本固定 2、小版本固定 3，后两段继续往上加：
    2.3.1.14 → 2.3.2.15 → …（本小版本提交数在本小版 tag 之后重新数）。

    InkCaseTotalOffset = 2 是让「总提交数」接上旧版本的 13：本仓库历史比旧版
    少两个提交，不补这一截就会出现 2.3.1.11 < 2.3.1.13 的倒流。

    大版本 / 小版本在这里手动改（发新小版本时先打 tag，比如 v2.4，
    后两段就会从 tag 之后重新数）。后两段由 git 现算，所以发布出来的
    exe 的版本号永远和当时的提交历史对得上，不需要手动同步。
    在没有 git 或者源码是解压包的情况下，回退到 2.3.0.0。
  -->
  <PropertyGroup>
    <InkCaseMajor>2</InkCaseMajor>
    <InkCaseMinor>3</InkCaseMinor>
    <InkCaseTotalOffset>2</InkCaseTotalOffset>
    <Version>$(InkCaseMajor).$(InkCaseMinor).0.0</Version>
  </PropertyGroup>

  <!-- 只有应用本体需要把版本号打进程序集；其它类库用上面的回退值即可。 -->
  <Target Name="InkCaseGitVersion" BeforeTargets="GenerateAssemblyInfo;GetAssemblyVersion"
          Condition="'$(MSBuildProjectName)' == 'InkCase.App'">

    <Exec Command="git rev-list --count HEAD"
          ConsoleToMSBuild="true" EchoOff="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="InkCaseTotalRaw" />
      <Output TaskParameter="ExitCode" PropertyName="InkCaseTotalExit" />
    </Exec>

    <Exec Command="git describe --tags --abbrev=0"
          ConsoleToMSBuild="true" EchoOff="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="InkCaseTagRaw" />
      <Output TaskParameter="ExitCode" PropertyName="InkCaseTagExit" />
    </Exec>

    <Exec Command="git rev-list --count $(InkCaseTagRaw.Trim())..HEAD"
          ConsoleToMSBuild="true" EchoOff="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          Condition="'$(InkCaseTagExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="InkCasePatchRaw" />
      <Output TaskParameter="ExitCode" PropertyName="InkCasePatchExit" />
    </Exec>

    <PropertyGroup Condition="'$(InkCaseTotalExit)' == '0'">
      <InkCaseTotalCommits>$([MSBuild]::Add($(InkCaseTotalRaw.Trim()), $(InkCaseTotalOffset)))</InkCaseTotalCommits>
      <InkCasePatchCommits Condition="'$(InkCasePatchExit)' == '0'">$(InkCasePatchRaw.Trim())</InkCasePatchCommits>
      <InkCasePatchCommits Condition="'$(InkCasePatchCommits)' == ''">$(InkCaseTotalCommits)</InkCasePatchCommits>
      <Version>$(InkCaseMajor).$(InkCaseMinor).$(InkCasePatchCommits).$(InkCaseTotalCommits)</Version>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <Message Importance="high" Text="墨案 版本号 $(Version)（大版本.小版本.本小版本提交数.总提交数）" />
  </Target>

</Project>
